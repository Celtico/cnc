{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["useSettings", "useOptionHidden", "useColorMode", "useColorModeValue", "toaster"] }],
    "react/refs": "off",
    "react/immutability": "off",
    "react/set-state-in-effect": "off"
  }
}
