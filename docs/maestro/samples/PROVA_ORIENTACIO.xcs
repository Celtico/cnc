// Mobles CNC - programa Maestro (MSL .xcs) - BETA: comprova'l a Maestro abans de mecanitzar
// Peca PROVA_ORIENTACIO: Prova d'orientacio (prova) - 600 x 400 x 19 - Aglomerat 19
// Cara A amunt. X = u (600 mm), Y = v (400 mm), origen a la cantonada de baix a l'esquerra (cantell 4 a X = 0, cantell 3 a Y = 0)
// Maquina SCM AA10008021 (AA10008021) - Maestro 2.00.004
// Noms d'eina i capcalera del projecte Proyecto1.pgmx (Maestro 2.0.5 rev 1005)

SetMachiningParameters("AD", 1, 10, 16973824, false);
CreateFinishedWorkpieceBox("PROVA_ORIENTACIO", 600, 400, 19);
CreateRawWorkpiece("PROVA_ORIENTACIO", 0, 0, 0, 0, 0, 0);

SelectWorkplane("Top");
// broca vertical O5 (003): eina automatica
CreateDrill("Forat_1", 50, 30, 5, 5, "", TypeOfProcess.Drilling, "-1", "-1");

SelectWorkplane("Front");
// broca horitzontal 019/020: Maestro tria el mandri segons el cantell
CreateDrill("ForatCantell_1", 100, 9.5, 15, 8, "", TypeOfProcess.Drilling, "-1", "-1");

SelectWorkplane("Right");
// broca horitzontal 019/020: Maestro tria el mandri segons el cantell
CreateDrill("ForatCantell_2", 100, 9.5, 15, 8, "", TypeOfProcess.Drilling, "-1", "-1");

SelectWorkplane("Back");
// broca horitzontal 019/020: Maestro tria el mandri segons el cantell
CreateDrill("ForatCantell_3", 500, 9.5, 15, 8, "", TypeOfProcess.Drilling, "-1", "-1");

SelectWorkplane("Left");
// broca horitzontal 019/020: Maestro tria el mandri segons el cantell
CreateDrill("ForatCantell_4", 300, 9.5, 15, 8, "", TypeOfProcess.Drilling, "-1", "-1");
