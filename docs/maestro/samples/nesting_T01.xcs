// Mobles CNC - programa Maestro (MSL .xcs) per tauler (nesting) - BETA: comprova'l a Maestro abans de mecanitzar
// Tauler T01 (Noguera_xapada_19#01): Noguera xapada - 2800 x 2070 x 19 - 19 peces - aprofitament 75%
// Cara de dalt (cara A de les peces). X, Y del tauler, origen a la cantonada de baix a l'esquerra
// Marge del tauler 10 mm, separacio 14 mm (12mm diamant nesting D12 + 2), contorns amb 12mm diamant nesting (D12), passants fins a 19.3 (gruix + 0.3 al martiri)
// Maquina SCM AA10008021 (AA10008021) - Maestro 2.00.004
// Noms d'eina i capcalera del projecte Proyecto1.pgmx (Maestro 2.0.5 rev 1005)
// Regles: ranures 8mm diamant (max 6 mm per passada), caixeres 12mm diamant nesting, perfilar 8-22 mm 12mm diamant nesting, 23-41 mm 14mm diamant nesting
// Peces petites (< 0.8 m2; grans, una passada): Z 1/XY 1 + Z 0.5/XY 0 + final; entrada en rampa 40 mm
// Peces (ref - nom - mida - cantonada al tauler - gir antihorari):
//   A.1.H.3 baix (Base) 1800 x 440 a (10, 10) gir 0
//   A.1.H.4 dalt (Sostre) 1800 x 440 a (10, 464) gir 0
//   A.1.L.1 lat e (Lateral esquerre) 700 x 440 a (1824, 10) gir 0
//   A.1.L.2 lat d (Lateral dret) 700 x 440 a (1824, 464) gir 0
//   A.1.L.6 divisor (Divisor) 662 x 440 a (10, 918) gir 0
//   A.1.L.7 divisor (Divisor) 662 x 440 a (686, 918) gir 0
//   A.1.H.26 estanter 2 (Prestatge 2 (pell de baix)) 611 x 421 a (1362, 918) gir 0
//   A.1.H.27 estanter 2 (Prestatge 2 (pell de dalt)) 611 x 421 a (1987, 918) gir 0
//   A.1.H.32 estanter 3 (Prestatge 3 (pell de baix)) 611 x 421 a (10, 1372) gir 0
//   A.1.H.33 estanter 3 (Prestatge 3 (pell de dalt)) 611 x 421 a (635, 1372) gir 0
//   A.1.H.8 estanter (Prestatge) 611 x 420 a (1260, 1372) gir 0
//   A.1.F.9 porta e (Porta esquerra) 658 x 302.5 a (1885, 1372) gir 0
//   A.1.F.28 estanter 2 (Prestatge 2 (tira del davant)) 611 x 50 a (10, 1807) gir 0
//   A.1.F.34 estanter 3 (Prestatge 3 (tira del davant)) 611 x 50 a (635, 1807) gir 0
//   A.1.H.29 estanter 2 (Prestatge 2 (llisto del darrere)) 611 x 12 a (1260, 1807) gir 0
//   A.1.H.35 estanter 3 (Prestatge 3 (llisto del darrere)) 611 x 12 a (1885, 1807) gir 0
//   A.1.H.31 estanter 2 (Prestatge 2 (llisto dret)) 402 x 12 a (10, 1871) gir 0
//   A.1.H.36 estanter 3 (Prestatge 3 (llisto esquerre)) 402 x 12 a (426, 1871) gir 0
//   A.1.H.37 estanter 3 (Prestatge 3 (llisto dret)) 402 x 12 a (842, 1871) gir 0
// Etiquetes (centre de cada peca):
//   A.1.H.3 (910, 230)
//   A.1.H.4 (910, 684)
//   A.1.L.1 (2174, 230)
//   A.1.L.2 (2174, 684)
//   A.1.L.6 (341, 1138)
//   A.1.L.7 (1017, 1138)
//   A.1.H.26 (1667.5, 1128.5)
//   A.1.H.27 (2292.5, 1128.5)
//   A.1.H.32 (315.5, 1582.5)
//   A.1.H.33 (940.5, 1582.5)
//   A.1.H.8 (1565.5, 1582)
//   A.1.F.9 (2214, 1523.25)
//   A.1.F.28 (315.5, 1832)
//   A.1.F.34 (940.5, 1832)
//   A.1.H.29 (1565.5, 1813)
//   A.1.H.35 (2190.5, 1813)
//   A.1.H.31 (211, 1877)
//   A.1.H.36 (627, 1877)
//   A.1.H.37 (1043, 1877)

MachineParameters mp=GetMachiningParameters();
SetMachiningParameters("AD", 1, 10, 16777216, false);
SetPreserveWorkingSequence(true);
SetWorkPieceFallPrevention(true);

CreateFinishedWorkpieceBox("Noguera_xapada_19#01", 2800, 2070, 19);
CreateRawWorkpiece("Noguera_xapada_19#01", 0, 0, 0, 0, 0, 0);
SetWorkpieceSetupPosition(0, -20, 0, 0);
CreateMacro("Pload", "PLOAD", 1, 0, 1, 0, 4, 2, false, 0, 0, 0, 0);

SelectWorkplane("Top");
SetPneumaticHoodPosition(1);
ResetAuxiliaryHood();
ResetDustpan();

