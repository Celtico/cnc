// Mobles CNC - programa Maestro (MSL .xcs) - BETA: comprova'l a Maestro abans de mecanitzar
// Peca PROVA_ORIENTACIO: Prova d'orientacio (prova) - 600 x 400 x 19 - Aglomerat 19
// Cara B amunt: la peca girada sobre l'eix X (el cantell 1 passa a Y = 0). Forats de cantell i talls: al programa de la cara A
// Maquina SCM AA10008021 (AA10008021) - Maestro 2.00.004

SetMachiningParameters("AD", 1, 10, 0, false);
CreateFinishedWorkpieceBox("PROVA_ORIENTACIO", 600, 400, 19);
CreateRawWorkpiece("PROVA_ORIENTACIO", 0, 0, 0, 0, 0, 0);

SelectWorkplane("Top");
CreateDrill("Forat_1", 50, 370, 5, 8, "", TypeOfProcess.Drilling, "006", "-1");
