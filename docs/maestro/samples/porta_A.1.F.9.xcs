// Mobles CNC - programa Maestro (MSL .xcs) - BETA: comprova'l a Maestro abans de mecanitzar
// Peca A.1.F.9: Porta esquerra (porta e) - 658 x 302.5 x 19 - Noguera xapada
// Cara A amunt. X = u (658 mm), Y = v (302.5 mm), origen a la cantonada de baix a l'esquerra (cantell 4 a X = 0, cantell 3 a Y = 0)
// Maquina SCM AA10008021 (AA10008021) - Maestro 2.00.004
// Noms d'eina i capcalera del projecte Proyecto1.pgmx (Maestro 2.0.5 rev 1005)
// Ordre de treball: CNC: A.1.F.9.xcs -> cantejadora
// Despres de la CNC:
//   1. Cantejar cantells 1+2+3+4 (cantejadora)

SetMachiningParameters("AD", 1, 10, 16973824, false);
CreateFinishedWorkpieceBox("A.1.F.9", 658, 302.5, 19);
CreateRawWorkpiece("A.1.F.9", 0, 0, 0, 0, 0, 0);

SelectWorkplane("Top");
// broca vertical O35 (013): eina automatica
CreateDrill("Forat_1", 115, 22.5, 13, 35, "", TypeOfProcess.Drilling, "-1", "-1");
// broca vertical O35 (013): eina automatica
CreateDrill("Forat_2", 563, 22.5, 13, 35, "", TypeOfProcess.Drilling, "-1", "-1");
// broca vertical O5 (003): eina automatica
CreateDrill("ForatPassant_1", 265, 262.5, 20, 5, "", TypeOfProcess.Drilling, "-1", "-1");
// broca vertical O5 (003): eina automatica
CreateDrill("ForatPassant_2", 393, 262.5, 20, 5, "", TypeOfProcess.Drilling, "-1", "-1");
